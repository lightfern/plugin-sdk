{
  "name": "@lightfern/plugin-sdk",
  "version": "3.1.5",
  "description": "The contract between Lightfern plugins and the Lightfern desktop host: manifest schema, view context, React bindings, wire protocol and theme tokens.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightfern/plugin-sdk.git"
  },
  "homepage": "https://github.com/lightfern/plugin-sdk#readme",
  "bugs": "https://github.com/lightfern/plugin-sdk/issues",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./server": "./src/server.ts",
    "./match": "./src/match.ts",
    "./manifest": "./src/manifest.ts",
    "./testing": "./src/testing.ts",
    "./protocol": "./src/protocol.ts",
    "./theme.css": "./src/theme.css",
    "./docs/*": "./docs/*",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "oxlint --fix",
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
