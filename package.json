{
  "name": "@lightfern/plugin-sdk",
  "version": "2.4.1",
  "description": "The contract between Lightfern plugins and the Lightfern desktop host: manifest schema, view context, React bindings, wire protocol and theme tokens.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightfern/plugin-sdk.git"
  },
  "homepage": "https://github.com/lightfern/plugin-sdk#readme",
  "bugs": "https://github.com/lightfern/plugin-sdk/issues",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./match": "./src/match.ts",
    "./manifest": "./src/manifest.ts",
    "./testing": "./src/testing.ts",
    "./protocol": "./src/protocol.ts",
    "./theme.css": "./src/theme.css",
    "./docs/*": "./docs/*",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": "prettier --write",
    ".prettierrc": "prettier --write"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
